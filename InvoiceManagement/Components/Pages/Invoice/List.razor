@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using InvoiceManagement.Models
@using InvoiceManagement.Services.Interfaces
@using InvoiceManagement.Services.Implementations
@using Microsoft.JSInterop
@inject IInvoiceService InvoiceService
@inject IJSRuntime JS
@inject ILogger<List> Logger
@inject FlashMessageService FlashMessageService

<PageTitle>Invoices</PageTitle>

<div class="container">

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h4 class="mb-0 fw-bold d-flex align-items-center">
                    Invoices
                </h4>
                @if (isLoading)
                {
                    <div class="spinner spinner-grow spinner-grow-sm ms-2"></div>

                }
            </div>
            <a href="/invoice/create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> New
            </a>
        </div>
        <div class="card-body p-0">
            
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px">#</th>

                            <th style="width:100px">Number</th>
                            <th style="width: 150px">Date</th>

                            <th>Customer</th>
                            <th style="width: 150px">Items</th>

                            <th style="width: 15%">Amount</th>
                            <th style="width: 20%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (invoices.Count == 0 && !isLoading)
                        {
                            <tr>
                                <td colspan="99">
                                    <div class="p-5 text-center text-muted">No invoices yet.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < invoices.Count; i++)
                            {
                                var invoice = invoices[i];
                                var rowNumber = i + 1;

                                <tr @key="invoice.Id">
                                    <td class="fw-semibold bg-light">
                                        @rowNumber </td>

                                        <td class="fw-semibold">@invoice.Number</td>
                                        <td>@invoice.Date.ToString("dd/MM/yyyy")</td>

                                        <td>@invoice.CustomerName</td>
                                        <td>
                                            <div class="badge badge-sm bg-info">
                                                @invoice.Items.Count
                                            </div>
                                        </td>

                                        <td class="fw-semibold">@invoice.TotalAmount.ToString("C")


                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end">
                                                <a href="@($"/invoice/edit/{invoice.Id}")"
                                                   class="btn btn-warning rounded-end-0 @(isLoading ? "disabled" : "")">
                                                    <i class="bi bi-pen"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-danger rounded-start-0 @(isLoading ? "disabled" : "")"
                                                        @onclick="() => Delete(invoice)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            
            </div>
        </div>
    </div>

@code {

    private List<Invoice> invoices = new();
    private bool isLoading = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && FlashMessageService.Has("FormSubmitted"))
        {
            var message = FlashMessageService.Get("FormSubmitted");

            await JS.InvokeVoidAsync("toast", message);
        }
    }

    private async Task LoadAsync()
    {

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            invoices = await InvoiceService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load invoices";
            Logger.LogError(ex, "Failed to load invoices");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Delete(Invoice invoice)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmDelete",
    $"Delete invoice <b>#{invoice.Number}</b> for <b>{invoice.CustomerName}</b>?");

        if (!confirmed) return;
       
        try
        {
            await InvoiceService.DeleteAsync(invoice.Id);
            await LoadAsync();
            await JS.InvokeVoidAsync("toast", "Invoice deleted successfully.");
        }
        catch (Exception ex)
        {
            errorMessage = "Delete failed";
            Logger.LogError(ex, "Failed to delete invoice {InvoiceId}", invoice?.Id);
        }
    }
}