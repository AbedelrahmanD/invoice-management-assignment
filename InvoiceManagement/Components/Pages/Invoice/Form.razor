@page "/invoice/create"
@page "/invoice/edit/{Id:int}"
@rendermode InteractiveServer
@using InvoiceManagement.Models
@using InvoiceManagement.Services.Interfaces
@inject IInvoiceService InvoiceService
@inject NavigationManager NavigationManager

<PageTitle>@pageTitle</PageTitle>

<div class="container">

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">
                @pageTitle
                <span class="text-success">#@displayInvoiceNumber</span>
            </h4>
        </div>

        <div class="card-body p-4">
            <EditForm Model="@invoice" FormName="InvoiceForm" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="row g-3 mb-4">
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label required">
                            Customer name
                        </label>
                        <InputText class="form-control" @bind-Value="invoice.CustomerName" placeholder="e.g. Acme Corp" />
                        <ValidationMessage For="() => invoice.CustomerName" />
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <label class="form-label required">
                            Date
                        </label>
                        <InputDate class="form-control" @bind-Value="invoice.Date" />
                        <ValidationMessage For="() => invoice.Date" />
                    </div>
                </div>

                <hr class="mb-4" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0 fw-bold">
                        Line Items
                        <span class="badge text-bg-secondary rounded-pill ms-2">@invoice.Items.Count</span>
                    </h5>
                    <button type="button" class="btn btn-sm btn-success" @onclick="AddLine">
                        <svg xmlns="http://w3.org" width="14" height="14" viewBox="0 0 1024 1024" class="me-1">
                            <path fill="currentColor" d="M482 152h60q8 0 8 8v704q0 8-8 8h-60q-8 0-8-8V160q0-8 8-8" />
                            <path fill="currentColor" d="M192 474h672q8 0 8 8v60q0 8-8 8H160q-8 0-8-8v-60q0-8 8-8Z" />
                        </svg>
                        Add Line
                    </button>
                </div>

                @if (invoice.Items.Count == 0)
                {
                    <div style="height: 250px;" class="alert alert-light border text-center text-muted mb-3 d-flex justify-content-center align-items-center">
                        No line items yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive overflow-auto" style="height: 250px;">
                        <table class="table align-middle mb-3">
                            <thead class="table-light position-sticky top-0" style="z-index: 1;">
                                <tr>
                                    <th class="required" style="width: 40%">Name</th>
                                    <th class="required" style="width: 15%">Quantity</th>
                                    <th class="required" style="width: 20%">Price</th>
                                    <th class="required text-end" style="width: 15%">Line Total</th>
                                    <th style="width: 10%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < invoice.Items.Count; i++)
                                {
                                    int index = i;
                                    var invoiceItem = invoice.Items[i];

                                    <tr @key="invoiceItem">
                                        <td>
                                            <InputText class="form-control form-control-sm" @bind-Value="invoice.Items[index].Name" placeholder="Item name" />
                                            <ValidationMessage For="() => invoice.Items[index].Name" />
                                        </td>
                                        <td>
                                            <InputNumber ParsingErrorMessage="Must be a number" class="form-control form-control-sm" @bind-Value="invoice.Items[index].Quantity" />
                                            <ValidationMessage For="() => invoice.Items[index].Quantity" />
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">$</span>
                                                <InputNumber ParsingErrorMessage="Must be a number" class="form-control" @bind-Value="invoice.Items[index].Price" />
                                            </div>
                                            <ValidationMessage For="() => invoice.Items[index].Price" />
                                        </td>
                                        <td class="text-end fw-semibold text-nowrap">
                                            @invoiceItem.LineTotal.ToString("C")
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(index)">
                                                <svg xmlns="http://w3.org" width="14" height="14" viewBox="0 0 32 32">
                                                    <path fill="currentColor" d="M17.414 16L24 9.414L22.586 8L16 14.586L9.414 8L8 9.414L14.586 16L8 22.586L9.414 24L16 17.414L22.586 24L24 22.586z" />
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end align-items-center bg-light border border-top-0 rounded-bottom px-3 py-2 mb-3">
                        <span class="fw-bold me-3">Total:</span>
                        <span class="fw-bold fs-5">@invoice.Items.Sum(x => x.LineTotal).ToString("C")</span>
                    </div>
                }

                <div class="d-flex justify-content-end align-items-center mt-4 pt-3 border-top gap-2">
                    <div>
                        @if (Id.HasValue)
                        {
                            if (confirmingDelete)
                            {
                                <span class="text-danger me-2">Delete this invoice?</span>
                                <button type="button" class="btn btn-danger" @onclick="HandleDelete" disabled="@isSubmitting">
                                    Yes, delete
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmingDelete = false" disabled="@isSubmitting">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger" @onclick="() => confirmingDelete = true" disabled="@isSubmitting">
                                    Delete
                                </button>
                            }
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span>Saving...</span>
                            }
                            else if (Id.HasValue)
                            {
                                <text>Update</text>
                            }
                            else
                            {
                                <text>Create</text>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private string pageTitle = string.Empty;
    private int displayInvoiceNumber;
    private Invoice invoice = new() { Items = new List<InvoiceItem>() };

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private bool isSubmitting;
    private bool confirmingDelete;

    protected override async Task OnInitializedAsync()
    {
        pageTitle = Id.HasValue ? "Edit Invoice" : "Create Invoice";

        if (Id.HasValue)
        {
            var existingInvoice = await InvoiceService.FindAsync(Id.Value);
            if (existingInvoice != null)
            {
                invoice = existingInvoice;
                displayInvoiceNumber = invoice.Number;
            }
            else
            {
                NavigationManager.NavigateTo("/invoice/create");
            }
        }
        else
        {
            invoice.Date = DateTime.Today;
            displayInvoiceNumber = await InvoiceService.GetNextInvoiceNumberAsync();
        }
    }

    protected void AddLine()
    {
        invoice.Items.Add(new InvoiceItem());
        errorMessage = string.Empty;
    }

    protected void RemoveLine(int index)
    {
        if (index >= 0 && index < invoice.Items.Count)
        {
            invoice.Items.RemoveAt(index);
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            if (Id.HasValue)
            {
                await InvoiceService.UpdateAsync(invoice);
            }
            else
            {
                await InvoiceService.SaveAsync(invoice);
            }

            NavigationManager.NavigateTo("/");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            errorMessage = $"An unexpected system error occurred: {exception.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleDelete()
    {
        if (!Id.HasValue || isSubmitting) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            await InvoiceService.DeleteAsync(Id.Value);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception exception)
        {
            errorMessage = $"An error occurred while deleting the invoice: {exception.Message}";
            confirmingDelete = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}